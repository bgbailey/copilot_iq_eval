# Copy this file to .env and fill it in. .env stays on your machine (it's in .gitignore).
# Saved-answer runs (--answers) need none of this unless you publish to the Eventhouse.

# --- Sign-in: the dedicated test user, never a real employee --------------------------
TENANT_ID=00000000-0000-0000-0000-000000000000
CLIENT_ID=00000000-0000-0000-0000-000000000000    # app registration, see docs/deployment-guide.md
TEST_USER=eval.tester@contoso.com

# --- Ground truth: the certified semantic model the reference DAX runs against -------
SEMANTIC_MODEL_ID=00000000-0000-0000-0000-000000000000

# --- Evidence: the workspace monitoring Eventhouse of the semantic model workspace ----
MONITORING_QUERY_URI=https://<id>.<region>.kusto.fabric.microsoft.com
MONITORING_DATABASE=Monitoring KQL database
MONITORING_WAIT_SECONDS=120    # how long to wait for the query logs to arrive

# --- Results: the Eventhouse the scorecard app reads (leave blank to keep results local)
EVENTHOUSE_QUERY_URI=https://<id>.<region>.kusto.fabric.microsoft.com
EVENTHOUSE_DATABASE=EvalResults
