# Copy to .env and fill in. Never commit .env. In Fabric notebooks, set these with os.environ
# in the first cell, or keep secrets in Azure Key Vault (see docs/SETUP.md).
# Both unprefixed names and CFEVAL_<NAME> are accepted; CFEVAL_<NAME> takes precedence.

# --- Explicit operator context (no ambient credential/account fallback) ---
# Example synthetic GUID: 00000000-0000-0000-0000-000000000001
TENANT_ID=
# Optional display name and domain, shown alongside TENANT_ID throughout explicit login (e.g. Contoso / contoso.com)
TENANT_LABEL=
# Optional task/run prefix; a unique suffix is added to each browser context
AUTH_RUN_LABEL=
AZURE_SUBSCRIPTION_ID=
# Dedicated, already signed-in Azure CLI profile directory; never defaults to the shared profile
AZURE_CONFIG_DIR=
# Example: eval.operator@contoso.com
OPERATOR_UPN=
# Optional tenant-local object ID; checked in acquired tokens when provided
OPERATOR_OBJECT_ID=

# --- Copilot Chat API (delegated sign-in as an explicitly selected, Copilot-licensed test user) ---
CLIENT_ID=
# Example: eval.tester@contoso.com
TEST_USER_UPN=
TEST_USER_OBJECT_ID=
TIME_ZONE=America/New_York
# File path for the sign-in cache, or "keyvault" to keep it in Azure Key Vault (scheduled notebook runs)
TOKEN_CACHE=.cache/msal_token_cache.json
KEY_VAULT_URL=
TOKEN_CACHE_SECRET=cfeval-msal-token-cache

# --- Run behaviour & pluggable targets ---
# copilot-chat | transcript-import | mcp-agent | fabric-data-agent
TARGET=copilot-chat
# auto | with_engine_evidence | without_engine_evidence | tool_call_evidence | work_iq
GATE_PROFILE=auto
GOLDEN_SET=data/golden/golden_questions.csv
# followup (ask "why" as a second turn) | inline (ask for sources in the same turn) | off
EXPLAIN_MODE=followup
REPEATS=1
PAUSE_SECONDS=20
OUTPUT_DIR=runs

# --- HTTP resilience & observability ---
HTTP_TIMEOUT_S=60
HTTP_MAX_RETRIES=3
# Optional OpenTelemetry collector endpoint for GenAI span export
OTEL_ENDPOINT=

# --- Additional target endpoints (optional) ---
# Published Fabric Data Agent endpoint (experimental)
DATA_AGENT_ENDPOINT=
# Optional stdio command for an MCP server target
MCP_SERVER_COMMAND=

# --- Telemetry Eventhouse (KQL database for the evaluation tables) ---
EVENTHOUSE_WORKSPACE_ID=
# KQL database Fabric ITEM GUID; not the Eventhouse container item ID
EVENTHOUSE_DATABASE_ID=
EVENTHOUSE_QUERY_URI=
EVENTHOUSE_INGEST_URI=
# Actual engine databaseName from connection details (often a GUID, not the display name)
EVENTHOUSE_DATABASE=

# --- Existing app lakehouse (never created/deleted by setup commands) ---
LAKEHOUSE_WORKSPACE_ID=
# LAKEHOUSE ITEM id: used for shortcuts and the app connector, NOT the SQL endpoint id
LAKEHOUSE_ID=
# Tables for a legacy lakehouse; Tables/dbo for a schema-enabled one
LAKEHOUSE_SHORTCUT_PATH=Tables
# Optional cross-checks: setup resolves these from the existing lakehouse
SQL_ENDPOINT_ID=
SQL_ENDPOINT_SERVER=
SQL_ENDPOINT_DATABASE=
SQL_SCHEMA=dbo
SQL_ODBC_DRIVER=ODBC Driver 18 for SQL Server
DEMO_APP_URL=

# --- DAX capture: workspace monitoring of the workspace that holds the semantic models ---
MONITORING_QUERY_URI=
MONITORING_DATABASE=
# Optional JSON list of {"query_uri":"https://<cluster>","database":"<database>","workspace_id":"<id>"}
# Include every expected/decoy workspace. workspace_id enables a progress marker in each source.
MONITORING_SOURCES=
TRACE_WAIT_SECONDS=300
TRACE_POLL_SECONDS=20
TRACE_SETTLE_SECONDS=40
# Defaults to TEST_USER_UPN
TRACE_USER=
# Workspace ID of the semantic models: enables the DAX watermark and golden-refresh
SEMANTIC_MODEL_WORKSPACE_ID=

# --- Option 1: Local scoring + optional Foundry model as judge ---
JUDGE_ENDPOINT=
JUDGE_DEPLOYMENT=gpt-5-mini
JUDGE_API_KEY=
JUDGE_API_KEY_SECRET=
JUDGE_GATES_VERDICT=false

# --- Option 2: Microsoft Foundry Evaluations ---
# https://<account>.services.ai.azure.com/api/projects/<project>
FOUNDRY_PROJECT_ENDPOINT=
FOUNDRY_RESOURCE_ENDPOINT=
FOUNDRY_EVAL_DEPLOYMENT=gpt-5-mini
FOUNDRY_BUILTIN_EVALUATORS=true
# Fabric notebooks can't use the Azure CLI: a service principal whose secret is in Key Vault
FOUNDRY_SP_CLIENT_ID=
FOUNDRY_SP_SECRET_NAME=
